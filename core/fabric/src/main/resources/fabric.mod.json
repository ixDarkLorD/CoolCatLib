{
  "schemaVersion": 1,
  "id": "${modid}",
  "version": "${mc_version}-${mod_version}",

  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "${mod_page_url}",
    "issues": "${mod_issue_url}",
    "sources": "${mod_source_url}"
  },

  "license": "${mod_license}",
  "icon": "mod_logo.png",

  "environment": "${mod_environment}",
  "entrypoints": {
    "main": [
      "net.ixdarklord.coolcatcore.internal.core.fabric.FabricSetup"
    ],
    "client": [
      "net.ixdarklord.coolcatcore.internal.core.fabric.FabricClientSetup"
    ],
    "server": [
      "net.ixdarklord.coolcatcore.internal.core.fabric.FabricServerSetup"
    ],
    "jei_mod_plugin": [
      "net.ixdarklord.coolcatcore.internal.integration.jei.JEIIntegration"
    ]
  },
  "mixins": [
    "${modid}.fabric.mixins.json",
    "${modid}.common.mixins.json"
  ],

  "custom": {
    "glazedmenu": {
      "library": true,
      "update_json": "${mod_neoforge_update_url}"
    },
    "modmenu": {
      "badges": ["library"]
    },
    "configured": {
      "providers": [
        "net.ixdarklord.coolcatcore.internal.integration.configured.ConfiguredProvider"
      ]
    },
    "loom:injected_interfaces": {
      "net/minecraft/world/item/alchemy/PotionBrewing": ["net/ixdarklord/coolcatcore/api/brewing/fabric/ext/PotionBrewingExt"],
      "net/minecraft/world/item/alchemy/PotionBrewing\u0024Builder": ["net/ixdarklord/coolcatcore/api/brewing/fabric/ext/PotionBrewingBuilderExt"]
    }
  },

  "depends": {
    "java": ">=${versions.java.get()}",
    "minecraft": ">=${project.supported_min_mc_version} <=${max_mc_version}",
    "fabricloader": ">=${min_fabric_version}",
    "fabric-api": ">=${project.supported_min_fabric_api_version}"
  }
}